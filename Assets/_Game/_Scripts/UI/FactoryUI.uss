:root {
    -unity-font-definition: url("project://database/Assets/_Game/Settings/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    -unity-font-style: normal;
    font-size: 18px;
    color: rgb(226, 232, 240);
    --color-bg-dark: rgb(26, 32, 44);
    --color-bg-panel: rgb(45, 55, 72);
    --color-cyan: rgb(0, 255, 255);
    --color-cyan-glow: rgba(0, 255, 255, 0.2);
    --color-button-bg: rgb(74, 85, 104);
    --color-button-hover: rgb(0, 255, 255);
    --color-button-active: rgb(0, 204, 204);
    --color-gold: rgb(255, 215, 0);
}

.factory-panel-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.8);
    picking-mode: ignore;
}

.factory-panel {
    background-color: var(--color-bg-dark);
    border-width: 2px;
    border-color: var(--color-cyan);
    border-radius: 12px;
    width: 500px;
    padding: 20px;
    picking-mode: position;
}

.header-label {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-cyan);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    text-shadow: 0 0 5px var(--color-cyan-glow);
}

.stats-container {
    background-color: var(--color-bg-panel);
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
}

.stat-label {
    font-size: 16px;
    margin-bottom: 5px;
}

.resource-selection {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 20px;
}

.resource-radio {
    margin: 5px;
}

.resource-radio > .unity-radio-button__checkmark-background {
    background-color: var(--color-bg-dark);
    border-color: var(--color-cyan);
    border-radius: 4px;
}

.resource-radio > .unity-radio-button__text {
    color: rgb(226, 232, 240);
    margin-left: 8px;
}

.action-button {
    background-color: var(--color-button-bg);
    border-width: 1px;
    border-color: var(--color-cyan);
    border-radius: 6px;
    color: white;
    font-size: 18px;
    padding: 10px 15px;
    margin-top: 10px;
    transition-duration: 0.2s;
}

.action-button:hover {
    background-color: var(--color-button-hover);
    color: var(--color-bg-dark);
    scale: 1.05;
}

.action-button:active {
    background-color: var(--color-button-active);
    scale: 0.95;
}

.upgrade-button {
    background-color: rgba(255, 215, 0, 0.1);
    border-color: var(--color-gold);
    color: var(--color-gold);
}

.upgrade-button:hover {
    background-color: var(--color-gold);
    color: var(--color-bg-dark);
}

.close-button {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-cyan);
    font-size: 20px;
    -unity-font-style: bold;
}

.close-button:hover {
    color: white;
}
