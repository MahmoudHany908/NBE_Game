<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/_Scripts/UI/FactoryUI.uss?fileID=7433441132597879392&amp;guid=f9b24cb2ace215941975b13e7b713369&amp;type=3#FactoryUI"/>
    <ui:VisualElement class="factory-panel-container">
        <ui:VisualElement class="top-bar">
            <ui:VisualElement class="resource-item">
                <ui:Label text="Gold" class="resource-name"/>
                <ui:Label name="gold-amount" text="0" class="resource-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="resource-item">
                <ui:Label text="Food" class="resource-name"/>
                <ui:Label name="food-amount" text="0" class="resource-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="resource-item">
                <ui:Label text="Energy" class="resource-name"/>
                <ui:Label name="energy-amount" text="0" class="resource-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="resource-item">
                <ui:Label text="Electronics" class="resource-name"/>
                <ui:Label name="electronics-amount" text="0" class="resource-value"/>
            </ui:VisualElement>
        </ui:VisualElement>
        
        <ui:VisualElement class="factory-panel">
            <ui:Button name="close-btn" text="X" class="close-button"/>
            <ui:Label name="header-label" text="GLOBAL FACTORY (LEVEL 1)" class="header-label"/>
            <ui:VisualElement class="stats-container">
                <ui:Label name="rate-label" text="Production Rate: 0/s" class="stat-label"/>
                <ui:Label name="capacity-label" text="Max Storage: 0" class="stat-label"/>
            </ui:VisualElement>
            <ui:Label text="Select Active Resource:" class="stat-label" style="margin-bottom: 10px;"/>
            <ui:VisualElement class="resource-selection">
                <ui:RadioButton name="radio-energy" text="Energy" class="resource-radio"/>
                <ui:RadioButton name="radio-food" text="Food" class="resource-radio"/>
                <ui:RadioButton name="radio-electronics" text="Electronics" class="resource-radio"/>
                <ui:RadioButton name="radio-gold" text="Gold" class="resource-radio"/>
            </ui:VisualElement>
            <ui:Button name="collect-btn" text="Collect (0)" class="action-button"/>
            <ui:Button name="upgrade-btn" text="Upgrade Factory (Cost: 100 Gold)" class="action-button upgrade-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
