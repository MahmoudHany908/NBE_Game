<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI%20ToolKit/USSFile.uss?fileID=7433441132597879392&amp;guid=2e958ceab897eb24bb405c8930669127&amp;type=3#USSFile"/>
    <ui:VisualElement name="root-container">
        <ui:VisualElement name="background-overlay"/>
        <ui:VisualElement name="settings-panel">
            <ui:VisualElement name="header">
                <ui:Label name="title" text="Settings"/>
                <ui:Button name="close-button" text="X"/>
            </ui:VisualElement>
            <ui:VisualElement name="content">
                <ui:Toggle name="volume-toggle" label="Mute All" value="false"/>
                <ui:Slider name="master-volume" label="Master" low-value="0" high-value="1" value="1"/>
                <ui:Slider name="music-volume" label="Music" low-value="0" high-value="1" value="1"/>
                <ui:Slider name="sfx-volume" label="SFX" low-value="0" high-value="1" value="1"/>
                <ui:Slider name="ambient-volume" label="Ambient" low-value="0" high-value="1" value="1"/>
            </ui:VisualElement>
            <ui:Button text="Enter Arena" name="transition-button" style="height: 36px; width: 186px; top: 26px; left: 24px; bottom: 0; right: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
