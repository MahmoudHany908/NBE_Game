.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 5, 12, 0.75);
}

.hidden {
    display: none;
}

.panel-box {
    width: 480px;
    padding: 32px;
    background-color: rgb(14, 16, 26);
    border-width: 2px;
    border-color: rgb(0, 229, 255);
    border-radius: 6px;
    align-items: center;
}

.title-label {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(0, 229, 255);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    letter-spacing: 2px;
}

.subtitle-label {
    font-size: 16px;
    color: rgb(255, 214, 0);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.action-button {
    width: 180px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 2px;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.15s;
}

.extract-btn {
    border-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.extract-btn:hover {
    background-color: rgba(0, 229, 255, 0.15);
}

.continue-btn {
    border-color: rgb(255, 0, 122);
    color: rgb(255, 0, 122);
}

.continue-btn:hover {
    background-color: rgba(255, 0, 122, 0.15);
}

.hint-label {
    font-size: 12px;
    color: rgb(140, 145, 160);
    -unity-text-align: middle-center;
    white-space: normal;
}
