.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 0, 4, 0.85);
}

.hidden {
    display: none;
}

.panel-box {
    width: 460px;
    padding: 32px;
    background-color: rgb(16, 10, 14);
    border-width: 2px;
    border-color: rgb(255, 0, 60);
    border-radius: 6px;
    align-items: center;
}

.title-label {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 0, 60);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.subtitle-label {
    font-size: 15px;
    color: rgb(180, 180, 190);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
}

.action-button {
    width: 180px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 2px;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.15s;
}

.retry-btn {
    border-color: rgb(255, 0, 60);
    color: rgb(255, 0, 60);
}

.retry-btn:hover {
    background-color: rgba(255, 0, 60, 0.15);
}

.hub-btn {
    border-color: rgb(0, 229, 255);
    color: rgb(0, 229, 255);
}

.hub-btn:hover {
    background-color: rgba(0, 229, 255, 0.15);
}
